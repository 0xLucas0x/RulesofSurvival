generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  ADMIN
}

enum AuthProvider {
  WALLET
  GUEST
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum GameRunStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  FAILED
}

enum RunActorType {
  HUMAN
  AGENT
}

enum NftTokenStandard {
  ERC721
  ERC1155
}

enum LlmProvider {
  GEMINI
  OPENAI
}

enum ImageProvider {
  POLLINATIONS
  OPENAI
}

enum UnlockLogic {
  ANY
}

enum StoryLifecycleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StoryVersionSource {
  MANUAL
  AI
  SEED
}

enum GuestInviteStatus {
  ACTIVE
  USED
  REVOKED
}

model User {
  id             String               @id @default(uuid()) @db.Uuid
  walletAddress  String               @unique @map("wallet_address")
  role           UserRole             @default(PLAYER)
  authProvider   AuthProvider         @default(WALLET) @map("auth_provider")
  status         UserStatus           @default(ACTIVE)
  createdAt      DateTime             @default(now()) @map("created_at")
  lastLoginAt    DateTime?            @map("last_login_at")
  nonces         SiweNonce[]
  revocations    JwtRevocation[]
  runs           GameRun[]
  runResults     RunResult[]
  redeemedInvites GuestInviteCode[]   @relation("GuestInviteRedeemer")
  createdInvites  GuestInviteCode[]   @relation("GuestInviteCreator")
  metricsAllTime UserMetricsAllTime?
  metrics7d      UserMetrics7d?

  @@map("users")
}

model SiweNonce {
  id          String    @id @default(uuid()) @db.Uuid
  nonce       String    @unique
  walletAddr  String?   @map("wallet_address")
  userId      String?   @db.Uuid @map("user_id")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdIp   String?   @map("created_ip")
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("siwe_nonces")
}

model JwtRevocation {
  id        String   @id @default(uuid()) @db.Uuid
  jti       String   @unique
  userId    String   @db.Uuid @map("user_id")
  revokedAt DateTime @default(now()) @map("revoked_at")
  expiresAt DateTime @map("expires_at")
  reason    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("jwt_revocations")
}

model RuntimeConfig {
  id             String        @id @default("default")
  llmProvider    LlmProvider   @default(GEMINI) @map("llm_provider")
  llmBaseUrl     String?       @map("llm_base_url")
  llmApiKeyEnc   String?       @map("llm_api_key_enc")
  llmModel       String?       @map("llm_model")
  imageProvider  ImageProvider @default(POLLINATIONS) @map("image_provider")
  imageBaseUrl   String?       @map("image_base_url")
  imageApiKeyEnc String?       @map("image_api_key_enc")
  imageModel     String?       @map("image_model")
  gameConfigJson Json          @map("game_config_json")
  currentStoryId String?       @db.Uuid @map("current_story_id")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  updatedBy      String?       @db.Uuid @map("updated_by")
  currentStory   Story?        @relation("RuntimeCurrentStory", fields: [currentStoryId], references: [id], onDelete: SetNull)

  @@map("runtime_config")
}

model Story {
  id               String               @id @default(uuid()) @db.Uuid
  slug             String               @unique
  title            String
  summary          String?
  sourceLocale     String               @default("zh-CN") @map("source_locale")
  status           StoryLifecycleStatus @default(DRAFT)
  draftVersionId   String?              @db.Uuid @map("draft_version_id")
  publishedVersionId String?            @db.Uuid @map("published_version_id")
  llmProvider      LlmProvider?         @map("llm_provider")
  llmBaseUrl       String?              @map("llm_base_url")
  llmApiKeyEnc     String?              @map("llm_api_key_enc")
  llmModel         String?              @map("llm_model")
  createdBy        String?              @db.Uuid @map("created_by")
  updatedBy        String?              @db.Uuid @map("updated_by")
  publishedBy      String?              @db.Uuid @map("published_by")
  publishedAt      DateTime?            @map("published_at")
  archivedAt       DateTime?            @map("archived_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  versions         StoryVersion[]       @relation("StoryVersions")
  draftVersion     StoryVersion?        @relation("StoryDraftVersion", fields: [draftVersionId], references: [id], onDelete: SetNull)
  publishedVersion StoryVersion?        @relation("StoryPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  runtimeConfigs   RuntimeConfig[]      @relation("RuntimeCurrentStory")
  runs             GameRun[]

  @@index([status, updatedAt])
  @@map("stories")
}

model StoryVersion {
  id                   String             @id @default(uuid()) @db.Uuid
  storyId              String             @db.Uuid @map("story_id")
  versionNo            Int                @map("version_no")
  source               StoryVersionSource @default(MANUAL)
  changeNote           String?            @map("change_note")
  initialStateJson     Json               @map("initial_state_json")
  instructionTemplateRaw String           @map("instruction_template_raw")
  instructionSectionsJson Json            @map("instruction_sections_json")
  generationInputJson  Json?              @map("generation_input_json")
  createdBy            String?            @db.Uuid @map("created_by")
  createdAt            DateTime           @default(now()) @map("created_at")
  story                Story              @relation("StoryVersions", fields: [storyId], references: [id], onDelete: Cascade)
  asDraftFor           Story[]            @relation("StoryDraftVersion")
  asPublishedFor       Story[]            @relation("StoryPublishedVersion")
  runsAtStart          GameRun[]          @relation("RunStoryVersionAtStart")

  @@unique([storyId, versionNo])
  @@index([storyId, createdAt])
  @@map("story_versions")
}

model ImageUnlockPolicy {
  id         String     @id @default("default")
  enabled    Boolean    @default(false)
  logic      UnlockLogic @default(ANY)
  chainId    Int        @default(10143) @map("chain_id")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  updatedBy  String?    @db.Uuid @map("updated_by")

  @@map("image_unlock_policy")
}

model ImageUnlockWhitelist {
  id            String   @id @default(uuid()) @db.Uuid
  walletAddress String   @unique @map("wallet_address")
  enabled       Boolean  @default(true)
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("image_unlock_whitelist")
}

model NftRequirement {
  id              String           @id @default(uuid()) @db.Uuid
  chainId         Int              @default(10143) @map("chain_id")
  contractAddress String           @map("contract_address")
  tokenStandard   NftTokenStandard @map("token_standard")
  tokenId         String?          @map("token_id")
  minBalance      String           @default("1") @map("min_balance")
  enabled         Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([enabled])
  @@index([chainId, contractAddress])
  @@map("nft_requirements")
}

model TokenRequirement {
  id              String   @id @default(uuid()) @db.Uuid
  chainId         Int      @default(10143) @map("chain_id")
  contractAddress String   @map("contract_address")
  minBalanceRaw   String   @map("min_balance_raw")
  decimals        Int      @default(18)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([enabled])
  @@index([chainId, contractAddress])
  @@map("token_requirements")
}

model GameRun {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @db.Uuid @map("user_id")
  storyId            String?       @db.Uuid @map("story_id")
  storyVersionIdAtStart String?    @db.Uuid @map("story_version_id_at_start")
  outputLocale       String        @default("zh-CN") @map("output_locale")
  status             GameRunStatus @default(ACTIVE)
  actorType          RunActorType  @default(HUMAN) @map("actor_type")
  startedAt          DateTime      @default(now()) @map("started_at")
  endedAt            DateTime?     @map("ended_at")
  currentTurnNo      Int           @default(0) @map("current_turn_no")
  finalScore         Int?          @map("final_score")
  finalSanity        Int?          @map("final_sanity")
  isVictory          Boolean?      @map("is_victory")
  configSnapshotJson Json          @map("config_snapshot_json")
  lastTurnId         String?       @db.Uuid @map("last_turn_id")
  activeKey          String?       @unique @map("active_key")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  story              Story?        @relation(fields: [storyId], references: [id], onDelete: SetNull)
  storyVersionAtStart StoryVersion? @relation("RunStoryVersionAtStart", fields: [storyVersionIdAtStart], references: [id], onDelete: SetNull)
  turns              GameTurn[]
  result             RunResult?

  @@index([userId, status])
  @@index([storyId, status])
  @@index([startedAt])
  @@index([status, actorType, updatedAt])
  @@map("game_runs")
}

model GameTurn {
  id              String   @id @default(uuid()) @db.Uuid
  runId           String   @db.Uuid @map("run_id")
  turnNo          Int      @map("turn_no")
  inputJson       Json     @map("input_json")
  outputJson      Json     @map("output_json")
  stateBeforeJson Json     @map("state_before_json")
  stateAfterJson  Json     @map("state_after_json")
  latencyMs       Int      @default(0) @map("latency_ms")
  createdAt       DateTime @default(now()) @map("created_at")
  run             GameRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, turnNo])
  @@index([runId, createdAt])
  @@map("game_turns")
}

model RunResult {
  runId        String   @id @db.Uuid @map("run_id")
  userId       String   @db.Uuid @map("user_id")
  score        Int
  isVictory    Boolean  @map("is_victory")
  turns        Int
  finalSanity  Int      @map("final_sanity")
  completedAt  DateTime @default(now()) @map("completed_at")
  run          GameRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@map("run_results")
}

model UserMetricsAllTime {
  userId        String   @id @db.Uuid @map("user_id")
  compositeScore Int     @default(0) @map("composite_score")
  victories     Int      @default(0)
  completedRuns Int      @default(0) @map("completed_runs")
  activeDays    Int      @default(0) @map("active_days")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_metrics_all_time")
}

model UserMetrics7d {
  userId        String   @id @db.Uuid @map("user_id")
  compositeScore Int     @default(0) @map("composite_score")
  victories     Int      @default(0)
  completedRuns Int      @default(0) @map("completed_runs")
  activeDays    Int      @default(0) @map("active_days")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_metrics_7d")
}

model LandingDailyStat {
  date         DateTime @id @db.Date
  dau          Int      @default(0)
  runsStarted  Int      @default(0) @map("runs_started")
  runsCompleted Int     @default(0) @map("runs_completed")
  victoryRate  Float    @default(0) @map("victory_rate")
  avgScore     Float    @default(0) @map("avg_score")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("landing_daily_stats")
}

model GuestInviteCode {
  id           String            @id @default(uuid()) @db.Uuid
  codeHash     String            @unique @map("code_hash")
  status       GuestInviteStatus @default(ACTIVE)
  campaign     String?
  expiresAt    DateTime?         @map("expires_at")
  usedAt       DateTime?         @map("used_at")
  usedByUserId String?           @db.Uuid @map("used_by_user_id")
  createdBy    String?           @db.Uuid @map("created_by")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  usedByUser   User?             @relation("GuestInviteRedeemer", fields: [usedByUserId], references: [id], onDelete: SetNull)
  creator      User?             @relation("GuestInviteCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([usedByUserId])
  @@index([createdAt])
  @@map("guest_invite_codes")
}
